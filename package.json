{
  "name": "ventoview",
  "productName": "Ventoview",
  "version": "1.8.3",
  "description": "Ventoview – Overlays für deinen Stream",
  "author": "Ventoview",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "6.8.10",
    "gifenc": "1.0.3",
    "mp4-muxer": "5.2.2",
    "uiohook-napi": "1.5.4",
    "webm-muxer": "5.1.4",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "gg.ventoview.app",
    "productName": "Ventoview",
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "core/**",
      "ui/**",
      "assets/**"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "LeonardoC98",
      "repo": "VentoviewApp"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Ventoview-Setup-${version}.${ext}"
    }
  }
}
